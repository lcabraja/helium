{
  "manifest_version": 3,
  "name": "Helium User Scripts",
  "version": "1.0.0",
  "description": "Personal JavaScript for the pages you choose.",
  "key": "",
  "permissions": [
    "storage",
    "userScripts",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "User Scripts",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
