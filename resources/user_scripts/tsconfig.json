{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome",
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "manager.tsx",
    "vite.config.ts",
    "*.js",
    "tests/*.ts"
  ]
}
