+  test('layout selection updates preferences and conditional controls',
+       async () => {
+         const dropdown = appearancePage.shadowRoot
+                              .querySelector<SettingsDropdownMenuElement>(
+                                  '#browserLayout');
+         assertTrue(!!dropdown);
+         const select = dropdown.$.dropdownMenu;
+         // CLASSIC=0, COMPACT=1, VERTICAL=2, DYNAMIC=3.
+         for (const layout of [2, 3, 1, 0]) {
+           select.value = String(layout);
+           select.dispatchEvent(new Event('change'));
+           await microtasksFinished();
+           assertEquals(layout, prefService.getPref('helium.browser.layout').value);
+           assertEquals(layout !== 2, toggle('vertical_right_aligned').hidden);
+           assertEquals(layout === 1, toggle('centered_location_bar').hidden);
+         }
+       });
+
+  test('zen mode retains separate sidebar and toolbar preferences', async () => {
+    await prefService.setPrefValue('helium.browser.layout', 2);
+    await microtasksFinished();
+    const sidebar = toggle('zen_mode_sidebar_pinned');
+    const toolbar = toggle('zen_mode_top_chrome_pinned');
+    assertTrue(sidebar.parentElement!.hidden);
+    toggle('zen_mode').click();
+    await microtasksFinished();
+    assertTrue(prefService.getPref<boolean>('helium.browser.zen_mode').value);
+    assertFalse(sidebar.parentElement!.hidden);
+    sidebar.click();
+    await microtasksFinished();
+    assertTrue(prefService.getPref<boolean>(
+        'helium.browser.zen_mode_sidebar_pinned').value);
+    assertFalse(prefService.getPref<boolean>(
+        'helium.browser.zen_mode_top_chrome_pinned').value);
+    toolbar.click();
+    await microtasksFinished();
+    assertTrue(prefService.getPref<boolean>(
+        'helium.browser.zen_mode_top_chrome_pinned').value);
+  });
+
+  test('container management action reaches the native handler', () => {
+    const row = appearancePage.shadowRoot.querySelector<CrLinkRowElement>(
+        '#toolbarRow cr-link-row');
+    assertTrue(!!row);
+    assertEquals(loadTimeData.getString('containerManage'), row.label);
+    const originalSend = chrome.send;
+    const messages: string[] = [];
+    try {
+      chrome.send = (message: string) => messages.push(message);
+      row.click();
+      assertEquals(1, messages.length);
+      assertEquals('manageContainers', messages[0]);
+    } finally {
+      chrome.send = originalSend;
+    }
   });
