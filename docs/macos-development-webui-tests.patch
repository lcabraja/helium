+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://customize-chrome-side-panel.top-chrome/appearance.js';
+
+import type {AppearanceElement} from 'chrome://customize-chrome-side-panel.top-chrome/appearance.js';
+import type {CustomizeChromePageRemote, Theme} from 'chrome://customize-chrome-side-panel.top-chrome/customize_chrome.mojom-webui.js';
+import {CustomizeChromePageCallbackRouter, CustomizeChromePageHandlerRemote} from 'chrome://customize-chrome-side-panel.top-chrome/customize_chrome.mojom-webui.js';
+import {CustomizeChromeApiProxy} from 'chrome://customize-chrome-side-panel.top-chrome/customize_chrome_api_proxy.js';
+import type {ManagedDialogElement} from 'chrome://resources/cr_components/managed_dialog/managed_dialog.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {assertEquals, assertFalse, assertTrue} from 'chrome://webui-test/chai_assert.js';
+import {fakeMetricsPrivate} from 'chrome://webui-test/metrics_test_support.js';
+import type {TestMock} from 'chrome://webui-test/test_mock.js';
+import {microtasksFinished} from 'chrome://webui-test/test_util.js';
+
+import {createBackgroundImage, createTheme, createThirdPartyThemeInfo, installMock} from './test_support.js';
+
+suite('HeliumAppearanceTest', () => {
+  let appearance: AppearanceElement;
+  let callback: CustomizeChromePageRemote;
+  let handler: TestMock<CustomizeChromePageHandlerRemote>;
+
+  async function setTheme(theme: Theme) {
+    callback.setTheme(theme);
+    await callback.$.flushForTesting();
+    await microtasksFinished();
+  }
+
+  setup(async () => {
+    document.body.innerHTML = window.trustedTypes!.emptyHTML;
+    loadTimeData.overrideValues({
+      showDeviceThemeToggle: true,
+      footerEnabled: false,
+    });
+    fakeMetricsPrivate();
+    handler = installMock(
+        CustomizeChromePageHandlerRemote,
+        mock => CustomizeChromeApiProxy.setInstance(
+            mock, new CustomizeChromePageCallbackRouter()));
+    callback = CustomizeChromeApiProxy.getInstance()
+                   .callbackRouter.$.bindNewPipeAndPassRemote();
+    appearance = document.createElement('customize-chrome-appearance');
+    document.body.appendChild(appearance);
+    await setTheme(createTheme());
+  });
+
+  test('uses one local wallpaper button and hides Google controls', () => {
+    assertFalse(appearance.$.editThemeButton.hidden);
+    appearance.$.editThemeButton.click();
+    assertEquals(1, handler.getCallCount('chooseLocalCustomBackground'));
+    assertTrue(appearance.$.themeSnapshot.hidden);
+    for (const id of [
+      'uploadedImageButton', 'searchedImageButton', 'wallpaperSearchButton',
+      'thirdPartyManageLinkButton',
+    ]) {
+      assertEquals(null, appearance.shadowRoot.querySelector(`#${id}`));
+    }
+    assertFalse(appearance.$.chromeColors.hidden);
+    assertTrue(appearance.$.setClassicChromeButton.hidden);
+  });
+
+  test('honors wallpaper editability changes', async () => {
+    callback.setThemeEditable(false);
+    await callback.$.flushForTesting();
+    await microtasksFinished();
+    assertTrue(appearance.$.editThemeButton.hidden);
+    callback.setThemeEditable(true);
+    await callback.$.flushForTesting();
+    await microtasksFinished();
+    assertFalse(appearance.$.editThemeButton.hidden);
+  });
+
+  for (const searched of [false, true]) {
+    test(`local wallpaper can be replaced or reset, searched=${searched}`,
+         async () => {
+           const theme = createTheme();
+           theme.backgroundImage = createBackgroundImage('local');
+           theme.backgroundImage.isUploadedImage = true;
+           if (searched) {
+             theme.backgroundImage.localBackgroundId = {low: 10n, high: 20n};
+           }
+           await setTheme(theme);
+           assertFalse(appearance.$.editThemeButton.hidden);
+           appearance.$.editThemeButton.click();
+           assertEquals(1, handler.getCallCount('chooseLocalCustomBackground'));
+           assertFalse(appearance.$.setClassicChromeButton.hidden);
+           appearance.$.setClassicChromeButton.click();
+           assertEquals(1, handler.getCallCount('removeBackgroundImage'));
+           assertEquals(1, handler.getCallCount('setDefaultColor'));
+         });
+  }
+
+  for (const button of ['editThemeButton', 'setClassicChromeButton'] as const) {
+    test(`managed theme blocks ${button}`, async () => {
+      const theme = createTheme();
+      theme.backgroundManagedByPolicy = true;
+      theme.backgroundImage = createBackgroundImage('managed');
+      await setTheme(theme);
+      appearance.$[button].click();
+      await microtasksFinished();
+      const dialog = appearance.shadowRoot.querySelector<ManagedDialogElement>(
+          'managed-dialog');
+      assertTrue(!!dialog);
+      assertTrue(dialog.$.dialog.open);
+      assertEquals(0, handler.getCallCount('chooseLocalCustomBackground'));
+      assertEquals(0, handler.getCallCount('removeBackgroundImage'));
+      assertEquals(0, handler.getCallCount('setDefaultColor'));
+    });
+  }
+
+  test('third party theme link and reset remain available', async () => {
+    const theme = createTheme();
+    theme.thirdPartyThemeInfo = createThirdPartyThemeInfo('theme-id', 'Theme');
+    await setTheme(theme);
+    assertFalse(appearance.$.thirdPartyThemeLinkButton.hidden);
+    assertTrue(appearance.$.chromeColors.hidden);
+    assertTrue(appearance.$.followThemeToggle.hidden);
+    appearance.$.thirdPartyThemeLinkButton.click();
+    assertEquals('theme-id', await handler.whenCalled('openThirdPartyThemePage'));
+    assertFalse(appearance.$.setClassicChromeButton.hidden);
+  });
+
+  test('device theme toggle follows state and sends changes', async () => {
+    const theme = createTheme();
+    theme.followDeviceTheme = true;
+    await setTheme(theme);
+    assertFalse(appearance.$.followThemeToggle.hidden);
+    assertTrue(appearance.$.followThemeToggleControl.checked);
+    appearance.$.followThemeToggleControl.click();
+    assertFalse(await handler.whenCalled('setFollowDeviceTheme'));
+  });
+});
