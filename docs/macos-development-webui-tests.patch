+  function toggle(key: string): SettingsToggleButtonElement {
+    const element = appearancePage.shadowRoot
+                        .querySelector<SettingsToggleButtonElement>(
+                            `[pref-key="helium.browser.${key}"]`);
+    assertTrue(!!element);
+    return element;
+  }
