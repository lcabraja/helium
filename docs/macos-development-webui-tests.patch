+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://new-tab-page/lazy_load.js';
+
+import type {AppElement, CustomizeButtonsDocumentRemote, PageRemote} from 'chrome://new-tab-page/new_tab_page.js';
+import {BackgroundManager, CustomizeButtonsDocumentCallbackRouter, CustomizeButtonsHandlerRemote, CustomizeButtonsProxy, NewTabPageProxy, PageCallbackRouter, PageHandlerRemote, WindowProxy} from 'chrome://new-tab-page/new_tab_page.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {assertDeepEquals, assertEquals, assertFalse, assertTrue} from 'chrome://webui-test/chai_assert.js';
+import {fakeMetricsPrivate} from 'chrome://webui-test/metrics_test_support.js';
+import type {TestMock} from 'chrome://webui-test/test_mock.js';
+import {microtasksFinished} from 'chrome://webui-test/test_util.js';
+
+import {createBackgroundImage, createTheme, installMock} from './test_support.js';
+
+suite('HeliumNewTabPageAppTest', () => {
+  let app: AppElement;
+  let callback: PageRemote;
+  let customizeCallback: CustomizeButtonsDocumentRemote;
+  let customizeHandler: TestMock<CustomizeButtonsHandlerRemote>;
+  let background: TestMock<BackgroundManager>;
+
+  async function recreateApp() {
+    document.body.innerHTML = window.trustedTypes!.emptyHTML;
+    app = document.createElement('ntp-app');
+    document.body.appendChild(app);
+    await microtasksFinished();
+  }
+
+  setup(async () => {
+    document.body.innerHTML = window.trustedTypes!.emptyHTML;
+    loadTimeData.overrideValues({
+      shortcutsEnabled: true,
+      showCustomizeButton: true,
+      modulesEnabled: false,
+      wallpaperSearchButtonEnabled: false,
+      searchboxShowComposeEntrypoint: false,
+      searchboxShowComposebox: false,
+      contextMenuAnimationLimitingEnabled: false,
+    });
+    fakeMetricsPrivate();
+    const windowProxy = installMock(WindowProxy);
+    windowProxy.setResultFor('url', new URL('chrome://new-tab-page/'));
+    windowProxy.setPromiseResolveFor('waitForLazyRender');
+    windowProxy.setResultMapperFor('matchMedia', (media: string) => ({
+      matches: false,
+      media,
+      addListener: () => {},
+      addEventListener: () => {},
+      removeListener: () => {},
+      removeEventListener: () => {},
+    }));
+    const handler = installMock(
+        PageHandlerRemote,
+        mock => NewTabPageProxy.setInstance(mock, new PageCallbackRouter()));
+    handler.setPromiseResolveFor('getMostVisitedSettings', {
+      customLinksEnabled: false,
+      shortcutsVisible: true,
+    });
+    handler.setPromiseResolveFor(
+        'canShowRealboxContextMenuAnimation', {canShow: false});
+    callback = NewTabPageProxy.getInstance()
+                   .callbackRouter.$.bindNewPipeAndPassRemote();
+    customizeHandler = installMock(
+        CustomizeButtonsHandlerRemote,
+        mock => CustomizeButtonsProxy.setInstance(
+            mock, new CustomizeButtonsDocumentCallbackRouter()));
+    customizeCallback = CustomizeButtonsProxy.getInstance()
+                            .callbackRouter.$.bindNewPipeAndPassRemote();
+    background = installMock(BackgroundManager);
+    background.setPromiseResolveFor('getBackgroundImageLoadTime', 123);
+    await recreateApp();
+  });
+
+  test('renders shortcuts and customization without Google UI', () => {
+    assertTrue(!!app.shadowRoot.querySelector('#mostVisited'));
+    assertTrue(!!app.$.customizeButtons);
+    for (const selector of [
+      '#logo', '#searchbox', '#composebox', '#oneGoogleBar', '#modules',
+      '#undoToast', '#webstoreToast', '#lensUploadDialog',
+    ]) {
+      assertEquals(null, app.shadowRoot.querySelector(selector), selector);
+    }
+  });
+
+  test('honors shortcut and customization preferences', async () => {
+    loadTimeData.overrideValues({
+      shortcutsEnabled: false,
+      showCustomizeButton: false,
+    });
+    await recreateApp();
+    assertEquals(null, app.shadowRoot.querySelector('#mostVisited'));
+    assertEquals(null, app.shadowRoot.querySelector('#customizeButtons'));
+  });
+
+  test('customization button opens the side panel', async () => {
+    app.$.customizeButtons.dispatchEvent(new Event('customize-click'));
+    const args =
+        await customizeHandler.whenCalled('setCustomizeChromeSidePanelVisible');
+    assertTrue(args[0]);
+    customizeCallback.setCustomizeChromeSidePanelVisibility(true);
+    await customizeCallback.$.flushForTesting();
+    await microtasksFinished();
+    assertTrue(app.$.customizeButtons.showCustomize);
+    customizeCallback.setCustomizeChromeSidePanelVisibility(false);
+    await customizeCallback.$.flushForTesting();
+    await microtasksFinished();
+    assertFalse(app.$.customizeButtons.showCustomize);
+  });
+
+  test('updates background and theme attribution', async () => {
+    const theme = createTheme();
+    theme.backgroundImage = createBackgroundImage('chrome://theme/background');
+    theme.backgroundImage.attributionUrl = 'chrome://theme/attribution';
+    callback.setTheme(theme);
+    await callback.$.flushForTesting();
+    await microtasksFinished();
+    assertDeepEquals(
+        theme.backgroundColor,
+        await background.whenCalled('setBackgroundColor'));
+    assertTrue(app.hasAttribute('show-background-image_'));
+    assertTrue(!!app.shadowRoot.querySelector('#themeAttribution'));
+    callback.setTheme(createTheme());
+    await callback.$.flushForTesting();
+    await microtasksFinished();
+    assertFalse(app.hasAttribute('show-background-image_'));
+    assertEquals(null, app.shadowRoot.querySelector('#themeAttribution'));
+  });
+});
