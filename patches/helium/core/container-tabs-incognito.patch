+IN_PROC_BROWSER_TEST_F(ContainerBrowserTest,
+                       IncognitoFiveMinuteRestoreAndExpiry) {
+  auto* original = OpenIncognito();
+  auto* profile = browser()->GetProfile();
+  const auto id = GetContainerId(original);
+  ASSERT_TRUE(content::ExecJs(original,
+                              "document.cookie = 'private=yes; path=/';"
+                              "localStorage.setItem('private','yes');"
+                              "sessionStorage.setItem('private','yes')"));
+  chrome::DuplicateTab(browser());
+  ASSERT_TRUE(content::WaitForLoadStop(
+      browser()->tab_strip_model()->GetActiveWebContents()));
+  CloseActive();
+  // Closing a duplicate does not start the timer while its sibling is open.
+  ExpireIncognitoContainersForTesting(profile,
+                                      base::TimeTicks::Now() + base::Hours(1));
+  EXPECT_TRUE(IsIncognitoContainerAvailable(profile, id));
+  EXPECT_FALSE(CookieKeys(id).empty());
+  auto* model = browser()->tab_strip_model();
+  model->ActivateTabAt(model->GetIndexOfWebContents(original));
+  CloseActive();
+  ExpireIncognitoContainersForTesting(
+      profile, base::TimeTicks::Now() + base::Minutes(4));
+  EXPECT_TRUE(IsIncognitoContainerAvailable(profile, id));
+  chrome::RestoreTab(browser());
+  auto* restored = model->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(restored));
+  EXPECT_EQ(id, GetContainerId(restored));
+  EXPECT_EQ("private=yes", content::EvalJs(restored, "document.cookie"));
+  EXPECT_EQ("yes",
+            content::EvalJs(restored, "localStorage.getItem('private')"));
+  EXPECT_EQ("yes",
+            content::EvalJs(restored, "sessionStorage.getItem('private')"));
+  CloseActive();
+  ExpireIncognitoContainersForTesting(
+      profile,
+      base::TimeTicks::Now() + kIncognitoRestoreGrace + base::Seconds(1));
+  EXPECT_FALSE(IsIncognitoContainerAvailable(profile, id));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !HasIncognitoCleanupPendingForTesting(profile); }));
+  EXPECT_TRUE(CookieKeys(id).empty());
+  chrome::RestoreTab(browser());
+  restored = model->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(restored));
+  EXPECT_TRUE(IsIncognitoTab(restored));
+  EXPECT_NE(id, GetContainerId(restored));
+  EXPECT_EQ("", content::EvalJs(restored, "document.cookie"));
+  EXPECT_EQ(true, content::EvalJs(restored,
+                                  "localStorage.getItem('private') === null"));
+  EXPECT_EQ(true, content::EvalJs(
+                      restored, "sessionStorage.getItem('private') === null"));
+}
