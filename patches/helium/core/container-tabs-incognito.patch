+  ASSERT_TRUE(content::WaitForLoadStop(child));
+  EXPECT_TRUE(IsIncognitoTab(child));
+  EXPECT_TRUE(identities.insert(GetContainerId(child)).second);
+  EXPECT_EQ("", content::EvalJs(child, "document.cookie"));
+}
