+  ASSERT_TRUE(content::ExecJs(work, "localStorage.setItem('account', 'work')"));
+  Open({});
+  auto* lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(work);
+  ASSERT_TRUE(lifecycle);
+  ASSERT_TRUE(
+      lifecycle->DiscardTab(mojom::LifecycleUnitDiscardReason::EXTERNAL));
+  ExpireIncognitoContainersForTesting(browser()->GetProfile(),
+                                      base::TimeTicks::Now() + base::Hours(1));
+  EXPECT_TRUE(IsIncognitoContainerAvailable(browser()->GetProfile(), id));
+  EXPECT_EQ(id, GetContainerId(model->GetWebContentsAt(index)));
+  content::TestNavigationObserver resumed(model->GetWebContentsAt(index));
+  model->ActivateTabAt(index);
+  resumed.Wait();
+  ASSERT_TRUE(resumed.last_navigation_succeeded());
+  EXPECT_EQ(partition, model->GetWebContentsAt(index)
