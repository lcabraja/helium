+}  // namespace
+
+bool IsIncognitoContainerId(const std::string& id) {
+  return id.starts_with(kIncognitoPrefix) &&
+         base::Uuid::ParseLowercase(
+             std::string_view(id).substr(sizeof(kIncognitoPrefix) - 1))
+             .is_valid();
+}
+
+bool IsIncognitoTab(content::WebContents* contents) {
+  return IsIncognitoContainerId(GetContainerId(contents));
+}
+
+std::string CreateIncognitoContainer(Profile* profile) {
+  return IncognitoState::Get(profile)->Create();
+}
+
+bool IsIncognitoContainerAvailable(Profile* profile, const std::string& id) {
+  return IsIncognitoContainerId(id) &&
+         IncognitoState::Get(profile)->Available(id);
+}
+
+void TrackIncognitoTab(content::WebContents* contents) {
+  if (!contents || contents->GetUserData(&kIncognitoLeaseKey)) {
+    return;
+  }
+  const auto id = GetContainerId(contents);
+  if (IsIncognitoContainerId(id)) {
+    auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+    contents->SetUserData(
+        &kIncognitoLeaseKey,
+        std::make_unique<IncognitoLease>(IncognitoState::Get(profile), id));
+  }
+}
+
+void ExpireIncognitoContainersForTesting(Profile* profile,
+                                         base::TimeTicks now) {
+  IncognitoState::Get(profile)->Expire(now);
+}
+
+bool HasIncognitoCleanupPendingForTesting(Profile* profile) {
+  return IncognitoState::Get(profile)->cleanup_pending();
+}
