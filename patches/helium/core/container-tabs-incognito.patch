+const char kIncognitoStateKey[] = "helium.incognito_state";
+const char kIncognitoLeaseKey[] = "helium.incognito_lease";
+// Match the order of magnitude of Chromium's 25-entry closed-tab buffer.
+constexpr int kMaxClosedJars = 25;
+
+class IncognitoState : public base::SupportsUserData::Data {
+ public:
+  explicit IncognitoState(Profile* profile) : profile_(profile) {}
+
+  static IncognitoState* Get(Profile* profile) {
+    auto* state =
+        static_cast<IncognitoState*>(profile->GetUserData(&kIncognitoStateKey));
+    if (!state) {
+      auto owned = std::make_unique<IncognitoState>(profile);
+      state = owned.get();
+      profile->SetUserData(&kIncognitoStateKey, std::move(owned));
+    }
+    return state;
+  }
+
+  std::string Create() {
+    const std::string id = std::string(kIncognitoPrefix) +
+                           base::Uuid::GenerateRandomV4().AsLowercaseString();
+    entries_[id].expires = base::TimeTicks::Now() + kIncognitoRestoreGrace;
+    EnforceClosedLimit();
+    ScheduleExpiry();
+    return id;
+  }
+
+  bool Available(const std::string& id) {
+    Expire(base::TimeTicks::Now());
+    return entries_.contains(id);
+  }
+
+  void Acquire(const std::string& id) {
+    // Renderer-created, isolated popup partitions arrive here without Create().
+    auto& entry = entries_[id];
+    ++entry.tabs;
+    entry.expires = base::TimeTicks();
+    ScheduleExpiry();
+  }
+
+  void Release(const std::string& id) {
+    auto it = entries_.find(id);
+    CHECK(it != entries_.end());
+    CHECK_GT(it->second.tabs, 0u);
+    if (--it->second.tabs == 0) {
+      it->second.expires = base::TimeTicks::Now() + kIncognitoRestoreGrace;
+      EnforceClosedLimit();
+      ScheduleExpiry();
+    }
+  }
+
+  void Expire(base::TimeTicks now) {
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      if (it->second.tabs == 0 && it->second.expires <= now) {
+        const std::string id = it->first;
+        it = entries_.erase(it);
+        EraseData(id);
+      } else {
+        ++it;
+      }
+    }
+    ScheduleExpiry();
+  }
+
+  bool cleanup_pending() const { return cleanup_pending_ != 0; }
+  base::WeakPtr<IncognitoState> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  struct Entry {
+    size_t tabs = 0;
+    base::TimeTicks expires;
+  };
+
+  void EnforceClosedLimit() {
+    while (std::ranges::count_if(entries_, [](const auto& item) {
+             return item.second.tabs == 0;
+           }) > kMaxClosedJars) {
+      auto oldest = entries_.end();
+      for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+        if (it->second.tabs == 0 &&
+            (oldest == entries_.end() ||
+             it->second.expires < oldest->second.expires)) {
+          oldest = it;
+        }
+      }
+      const std::string id = oldest->first;
+      entries_.erase(oldest);
+      EraseData(id);
+    }
+  }
+
+  void ScheduleExpiry() {
+    expiry_timer_.Stop();
+    auto next = base::TimeTicks::Max();
+    for (const auto& [id, entry] : entries_) {
+      if (entry.tabs == 0) {
+        next = std::min(next, entry.expires);
+      }
+    }
+    if (next != base::TimeTicks::Max()) {
+      expiry_timer_.Start(
+          FROM_HERE, std::max(base::TimeDelta(), next - base::TimeTicks::Now()),
+          base::BindOnce(
+              [](base::WeakPtr<IncognitoState> state) {
+                if (state) {
+                  state->Expire(base::TimeTicks::Now());
+                }
+              },
+              weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  void EraseData(const std::string& id) {
+    auto* partition = profile_->GetStoragePartition(
+        GetPartitionConfig(profile_, id), /*can_create=*/false);
+    if (!partition) {
+      return;
+    }
+    ++cleanup_pending_;
+    auto done =
+        base::BarrierClosure(3, base::BindOnce(
+                                    [](base::WeakPtr<IncognitoState> state) {
+                                      if (state) {
+                                        --state->cleanup_pending_;
+                                      }
+                                    },
+                                    weak_factory_.GetWeakPtr()));
+    // SessionStorage may still be referenced by a recently-closed entry. Clear
+    // the partition itself, not just its cookies or the UI's identity record.
+    partition->GetNetworkContext()->ClearHttpCache(
+        base::Time(), base::Time::Max(), nullptr, done);
+    partition->GetNetworkContext()->ClearHttpAuthCache(
+        base::Time(), base::Time::Max(), nullptr, done);
+    partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                         blink::StorageKey(), base::Time(), base::Time::Max(),
+                         done);
+  }
+
+  raw_ptr<Profile> profile_;
+  std::map<std::string, Entry> entries_;
+  size_t cleanup_pending_ = 0;
+  base::OneShotTimer expiry_timer_;
+  base::WeakPtrFactory<IncognitoState> weak_factory_{this};
+};
+
+class IncognitoLease : public base::SupportsUserData::Data {
+ public:
+  IncognitoLease(IncognitoState* state, std::string id)
+      : state_(state->GetWeakPtr()), id_(std::move(id)) {
+    state->Acquire(id_);
+  }
+  ~IncognitoLease() override {
+    if (state_) {
+      state_->Release(id_);
+    }
+  }
+
+ private:
+  base::WeakPtr<IncognitoState> state_;
+  std::string id_;
+};
