+        "document.body.appendChild(link); link.click();"}) {
+    ui_test_utils::AllBrowserTabAddedWaiter observer(/*expected_count=*/1);
+    ASSERT_TRUE(content::ExecJs(source, script));
+    auto* popup = observer.Wait();
+    ASSERT_TRUE(popup);
+    ASSERT_TRUE(content::WaitForLoadStop(popup));
+    EXPECT_TRUE(IsIncognitoTab(popup));
+    EXPECT_TRUE(identities.insert(GetContainerId(popup)).second);
+    EXPECT_EQ("", content::EvalJs(popup, "document.cookie"));
+    EXPECT_EQ(true, content::EvalJs(
+                        popup, "localStorage.getItem('private') === null"));
+    EXPECT_EQ(true, content::EvalJs(
+                        popup, "sessionStorage.getItem('private') === null"));
+    EXPECT_EQ(true, content::EvalJs(popup, "window.opener === null"));
