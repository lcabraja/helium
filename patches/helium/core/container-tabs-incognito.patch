+IN_PROC_BROWSER_TEST_F(ContainerBrowserTest, IncognitoStorageAndDuplicates) {
+  auto* original = OpenIncognito();
+  const auto id = GetContainerId(original);
+  auto* partition = original->GetPrimaryMainFrame()->GetStoragePartition();
+  EXPECT_TRUE(partition->GetConfig().in_memory());
+  ASSERT_TRUE(content::ExecJs(original, R"(
+    (async () => {
+      document.cookie = 'private=yes; max-age=3600; path=/';
+      localStorage.setItem('private', 'yes');
+      sessionStorage.setItem('private', 'yes');
+      await new Promise((resolve, reject) => {
+        const request = indexedDB.open('private', 1);
+        request.onupgradeneeded = () => request.result.createObjectStore('data');
+        request.onsuccess = () => { request.result.close(); resolve(); };
+        request.onerror = reject;
+      });
+      await caches.open('private');
+      await navigator.serviceWorker.register('/container-worker.js');
+      await navigator.serviceWorker.ready;
+    })()
+  )"));
+  chrome::DuplicateTab(browser());
+  auto* model = browser()->tab_strip_model();
+  auto* duplicate = model->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(duplicate));
+  EXPECT_EQ(id, GetContainerId(duplicate));
+  EXPECT_EQ(partition, duplicate->GetPrimaryMainFrame()->GetStoragePartition());
+  EXPECT_EQ("private=yes", content::EvalJs(duplicate, "document.cookie"));
+  EXPECT_EQ("yes",
+            content::EvalJs(duplicate, "sessionStorage.getItem('private')"));
+  auto* separate = OpenIncognito();
+  EXPECT_NE(id, GetContainerId(separate));
+  for (auto* tab : {separate, Open(Personal()), Open("")}) {
+    EXPECT_EQ("", content::EvalJs(tab, "document.cookie"));
+    EXPECT_EQ(true,
+              content::EvalJs(tab, "localStorage.getItem('private') === null"));
+    EXPECT_EQ(true, content::EvalJs(
+                        tab, "sessionStorage.getItem('private') === null"));
+    EXPECT_EQ(0,
+              content::EvalJs(
+                  tab, "(async () => (await indexedDB.databases()).length)()"));
+    EXPECT_EQ(0, content::EvalJs(
+                     tab, "(async () => (await caches.keys()).length)()"));
+    EXPECT_EQ(0, content::EvalJs(
+                     tab,
+                     "(async () => (await "
+                     "navigator.serviceWorker.getRegistrations()).length)()"));
+  }
+}
