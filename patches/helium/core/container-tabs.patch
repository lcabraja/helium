+class ContainerMenu : public ui::SimpleMenuModel,
+                      public ui::SimpleMenuModel::Delegate {
+ public:
+  ContainerMenu(BrowserWindowInterface* browser,
+                std::vector<GURL> urls,
+                std::vector<base::WeakPtr<content::WebContents>> reopen)
+      : ui::SimpleMenuModel(this),
+        browser_(browser->GetWeakPtr()),
+        urls_(std::move(urls)),
+        reopen_(std::move(reopen)),
+        containers_(GetContainers(browser->GetProfile())) {
+    AddItem(IDC_CONTAINER_DEFAULT, Text(IDS_CONTAINER_NONE));
+    for (size_t i = 0; i < containers_.size(); ++i) {
+      const auto& container = containers_[i];
+      AddItemWithIcon(IDC_CONTAINER_FIRST + i,
+                      GetIcon(container.icon) + u" " + container.name,
+                      ui::ImageModel::FromVectorIcon(
+                          kTabIcon, GetColor(container.color), 16));
+    }
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    AddItem(IDC_MANAGE_CONTAINERS, Text(IDS_CONTAINER_MANAGE));
+  }
+
+  bool IsCommandIdEnabled(int command_id) const override {
+    return browser_ && (command_id == IDC_MANAGE_CONTAINERS ||
+                        command_id == IDC_CONTAINER_DEFAULT ||
+                        IsEnabled(browser_->GetProfile()));
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (!browser_) {
+      return;
+    }
+    if (command_id == IDC_MANAGE_CONTAINERS) {
+      ShowContainerManager(browser_.get());
+      return;
+    }
+    std::string id;
+    if (command_id != IDC_CONTAINER_DEFAULT) {
+      const int index = command_id - IDC_CONTAINER_FIRST;
+      if (index < 0 || index >= static_cast<int>(containers_.size()) ||
+          !IsEnabled(browser_->GetProfile())) {
+        return;
+      }
+      id = containers_[index].id;
+      if (!FindContainer(browser_->GetProfile(), id)) {
+        return;
+      }
+    }
+    if (reopen_.empty()) {
+      OpenInContainer(browser_.get(), urls_, id);
+      return;
+    }
+    // Snapshot weak pointers, never tab indices, because opening a new tab can
+    // change the positions of every following tab.
+    for (const auto& original : reopen_) {
+      if (!original || GetContainerId(original.get()) == id) {
+        continue;
+      }
+      auto* model = browser_->GetTabStripModel();
+      if (model->GetIndexOfWebContents(original.get()) ==
+          TabStripModel::kNoTab) {
+        continue;
+      }
+      const int old_index = model->GetIndexOfWebContents(original.get());
+      const bool pinned = model->IsTabPinned(old_index);
+      const auto group = model->GetTabGroupForTab(old_index);
+      if (!OpenInContainer(browser_.get(), {original->GetVisibleURL()}, id)) {
+        continue;
+      }
+      int new_index = model->active_index();
+      new_index = model->SetTabPinned(new_index, pinned);
+      model->MoveWebContentsAt(new_index, old_index, true);
+      if (group && model->group_model()->ContainsTabGroup(*group)) {
+        model->AddToExistingGroup({model->active_index()}, *group);
+      }
+      const int index = model->GetIndexOfWebContents(original.get());
+      if (index != TabStripModel::kNoTab) {
+        model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+      }
+    }
+  }
+
+ private:
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  std::vector<GURL> urls_;
+  std::vector<base::WeakPtr<content::WebContents>> reopen_;
+  std::vector<Container> containers_;
+};
