+void BookmarksPageHandler::OpenInContainer(
+    const std::vector<std::string>& side_panel_ids) {
+  if (!browser_window_interface_ || side_panel_ids.empty()) {
+    return;
+  }
+  const auto node_ids =
+      GetBookmarkIDsFromSidePanelIDs(*bookmark_merged_surface_, side_panel_ids);
+  std::vector<GURL> urls;
+  auto collect = [&urls](auto&& self,
+                         const bookmarks::BookmarkNode* node) -> void {
+    if (!node) {
+      return;
+    }
+    if (node->is_url()) {
+      urls.push_back(node->url());
+    } else {
+      for (const auto& child : node->children()) {
+        self(self, child.get());
+      }
+    }
+  };
+  for (int64_t id : node_ids) {
+    collect(collect, bookmarks::GetBookmarkNodeByID(
+                         bookmark_merged_surface_->bookmark_model(), id));
+  }
+  if (!urls.empty()) {
+    helium::containers::ShowContainerPicker(browser_window_interface_,
+                                            std::move(urls));
+  }
+}
