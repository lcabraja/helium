+void ShowDialog(BrowserWindowInterface* browser,
+                std::unique_ptr<views::DialogDelegate> dialog) {
+  const auto native_window = browser->GetWindow()->GetNativeWindow();
+  auto* parent = views::Widget::GetWidgetForNativeWindow(native_window);
+  if (!parent) {
+    return;
+  }
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  views::DialogDelegate::CreateDialogWidget(std::move(dialog), native_window,
+                                            parent->GetNativeView())
+      ->Show();
+}
