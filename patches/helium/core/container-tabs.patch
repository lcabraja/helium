+class ContainerWebUIHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "openInContainer", base::BindRepeating(&ContainerWebUIHandler::Open,
+                                               base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "manageContainers", base::BindRepeating(&ContainerWebUIHandler::Manage,
+                                                base::Unretained(this)));
+  }
+
+ private:
+  void Open(const base::ListValue& args) {
+    auto* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (!browser || args.size() != 1 || !args[0].is_list()) {
+      return;
+    }
+    std::vector<GURL> urls;
+    for (const auto& value : args[0].GetList()) {
+      if (!value.is_string()) {
+        return;
+      }
+      GURL url(value.GetString());
+      if (!url.is_valid() ||
+          !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile() ||
+            url.SchemeIs("chrome") || url.IsAboutBlank())) {
+        return;
+      }
+      urls.push_back(std::move(url));
+    }
+    if (!urls.empty()) {
+      ShowContainerPicker(browser, std::move(urls));
+    }
+  }
+
+  void Manage(const base::ListValue& args) {
+    if (auto* browser =
+            webui::GetBrowserWindowInterface(web_ui()->GetWebContents())) {
+      ShowContainerManager(browser);
+    }
+  }
+};
