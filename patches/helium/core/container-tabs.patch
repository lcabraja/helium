+namespace helium::containers {
+
+class ContainerBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        [](const net::test_server::HttpRequest& request)
+            -> std::unique_ptr<net::test_server::HttpResponse> {
+          auto response =
+              std::make_unique<net::test_server::BasicHttpResponse>();
+          if (request.relative_url == "/container-worker.js") {
+            response->set_content_type("application/javascript");
+            response->set_content("self.addEventListener('fetch', () => {});");
+          } else {
+            response->set_content_type("text/html");
+            response->set_content(
+                "<!doctype html><title>Container test</title>");
+          }
+          return response;
+        }));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+ protected:
+  content::WebContents* Open(const std::string& id) {
+    OpenInContainer(browser(), {embedded_test_server()->GetURL("/test")}, id);
+    auto* tab = browser()->tab_strip_model()->GetActiveWebContents();
+    EXPECT_TRUE(content::WaitForLoadStop(tab));
+    EXPECT_EQ(id, GetContainerId(tab));
+    return tab;
+  }
+
+  std::string Personal() {
+    return GetContainers(browser()->GetProfile())[0].id;
+  }
+  std::string Work() { return GetContainers(browser()->GetProfile())[1].id; }
+
+  content::StoragePartition* Partition(const std::string& id) {
+    auto* profile = browser()->GetProfile();
+    return id.empty() ? profile->GetDefaultStoragePartition()
+                      : profile->GetStoragePartition(
+                            GetPartitionConfig(profile, id));
+  }
+
+  bool SeedCookie(const std::string& id,
+                  const GURL& url,
+                  const std::string& name,
+                  base::Time creation) {
+    auto cookie = net::CanonicalCookie::CreateForTesting(
+        url, name + "=yes; max-age=86400; path=/", creation,
+        net::CookieSourceType::kOther);
+    if (!cookie) {
+      return false;
+    }
+    base::test::TestFuture<net::CookieAccessResult> result;
+    Partition(id)->GetCookieManagerForBrowserProcess()->SetCanonicalCookie(
+        *cookie, url, net::CookieOptions::MakeAllInclusive(), result.GetCallback());
+    return result.Get().status.IsInclude();
+  }
+
+  std::set<std::string> CookieKeys(const std::string& id) {
+    base::test::TestFuture<std::vector<net::CanonicalCookie>> result;
+    Partition(id)->GetCookieManagerForBrowserProcess()->GetAllCookies(
+        result.GetCallback<const std::vector<net::CanonicalCookie>&>());
+    std::set<std::string> keys;
+    for (const auto& cookie : result.Get()) {
+      keys.insert(cookie.Domain() + "/" + cookie.Name());
+    }
+    return keys;
+  }
+
+  bool ClearCookies(
+      base::Time begin,
+      std::unique_ptr<content::BrowsingDataFilterBuilder> filter) {
+    auto* remover = browser()->GetProfile()->GetBrowsingDataRemover();
+    content::BrowsingDataRemoverCompletionObserver completion(remover);
+    remover->RemoveWithFilterAndReply(
+        begin, base::Time::Max(), content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+        content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+        std::move(filter), &completion);
+    completion.BlockUntilCompletion();
+    // The embedder queues one removal per container. The observer above belongs
+    // to the original request; wait for the queued partitions as well.
+    return completion.failed_data_types() == 0 && base::test::RunUntil([&] {
+      return remover->GetPendingTaskCountForTesting() == 0;
+    });
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ContainerBrowserTest, DefaultsAndValidatedEdits) {
+  auto* profile = browser()->GetProfile();
+  ASSERT_EQ(4u, GetContainers(profile).size());
+  EXPECT_FALSE(SaveContainer(profile, {}, u"   ", 0, 0));
+  EXPECT_FALSE(SaveContainer(profile, {}, std::u16string(65, u'x'), 0, 0));
+  EXPECT_FALSE(SaveContainer(profile, {}, u"Bad color", 8, 0));
+  EXPECT_FALSE(SaveContainer(profile, {}, u"Bad icon", 0, -1));
+  EXPECT_FALSE(SaveContainer(profile, "../outside", u"Bad ID", 0, 0));
+  const auto id = SaveContainer(profile, {}, u"  Accounts  ", 4, 6);
+  ASSERT_TRUE(id);
+  ASSERT_TRUE(FindContainer(profile, *id));
+  EXPECT_EQ(u"Accounts", FindContainer(profile, *id)->name);
+  EXPECT_EQ(id, SaveContainer(profile, *id, u"Renamed", 2, 1));
+  EXPECT_EQ(5u, GetContainers(profile).size());
+  EXPECT_EQ(u"Renamed", FindContainer(profile, *id)->name);
+}
+
+IN_PROC_BROWSER_TEST_F(ContainerBrowserTest,
+                       StorageIsSharedOnlyWithinIdentity) {
+  auto* work = Open(Work());
+  ASSERT_TRUE(content::ExecJs(work, R"(
+    (async () => {
+      document.cookie = 'account=work; max-age=3600; path=/';
+      localStorage.setItem('account', 'work');
+      await new Promise((resolve, reject) => {
+        const request = indexedDB.open('container-test', 1);
+        request.onupgradeneeded = () => request.result.createObjectStore('data');
+        request.onerror = reject;
+        request.onsuccess = () => {
+          const transaction = request.result.transaction('data', 'readwrite');
+          transaction.objectStore('data').put('work', 'account');
+          transaction.oncomplete = () => { request.result.close(); resolve(); };
+          transaction.onerror = reject;
+        };
+      });
+      const cache = await caches.open('container-test');
+      await cache.put('/account', new Response('work'));
+      await navigator.serviceWorker.register('/container-worker.js');
+      await navigator.serviceWorker.ready;
+    })()
+  )"));
+  auto* same = Open(Work());
+  EXPECT_EQ("account=work", content::EvalJs(same, "document.cookie"));
+  EXPECT_EQ("work", content::EvalJs(same, "localStorage.getItem('account')"));
+  EXPECT_EQ(1,
+            content::EvalJs(
+                same, "(async () => (await indexedDB.databases()).length)()"));
+  EXPECT_EQ(
+      1, content::EvalJs(same, "(async () => (await caches.keys()).length)()"));
+  EXPECT_EQ(1, content::EvalJs(
+                   same,
+                   "(async () => (await "
+                   "navigator.serviceWorker.getRegistrations()).length)()"));
+  for (const auto& id : {Personal(), std::string()}) {
