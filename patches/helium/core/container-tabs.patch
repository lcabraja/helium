+namespace helium::containers {
+namespace {
+
+bool IsValidId(const std::string& id) {
+  return base::Uuid::ParseLowercase(id).is_valid();
+}
+
+base::DictValue ToValue(const Container& container) {
+  return base::DictValue()
+      .Set("id", container.id)
+      .Set("name", base::UTF16ToUTF8(container.name))
+      .Set("color", container.color)
+      .Set("icon", container.icon);
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  base::ListValue defaults;
+  constexpr std::array<int, 4> names = {
+      IDS_CONTAINER_PERSONAL, IDS_CONTAINER_WORK, IDS_CONTAINER_BANKING,
+      IDS_CONTAINER_SHOPPING};
+  constexpr std::array<const char*, 4> ids = {
+      "00000000-0000-4000-8000-000000000001",
+      "00000000-0000-4000-8000-000000000002",
+      "00000000-0000-4000-8000-000000000003",
+      "00000000-0000-4000-8000-000000000004"};
+  for (size_t i = 0; i < names.size(); ++i) {
+    defaults.Append(ToValue({ids[i], l10n_util::GetStringUTF16(names[i]),
+                             static_cast<int>(i), static_cast<int>(i)}));
+  }
+  registry->RegisterListPref(kContainersPref, std::move(defaults));
+  registry->RegisterBooleanPref(kEnabledPref, true);
+  registry->RegisterBooleanPref(kAskForNewTabPref, false);
+}
+
+bool IsEnabled(Profile* profile) {
+  return profile && !profile->IsOffTheRecord() &&
+         profile->GetPrefs()->GetBoolean(kEnabledPref);
+}
+
+std::vector<Container> GetContainers(Profile* profile) {
+  std::vector<Container> containers;
+  if (!profile || profile->IsOffTheRecord()) {
+    return containers;
+  }
+  for (const auto& value : profile->GetPrefs()->GetList(kContainersPref)) {
+    const auto* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const auto* id = dict->FindString("id");
+    const auto* name = dict->FindString("name");
+    const auto color = dict->FindInt("color");
+    const auto icon = dict->FindInt("icon");
+    if (!id || !IsValidId(*id) || !name || name->empty() || !color ||
+        *color < 0 || *color >= static_cast<int>(kColorCount) || !icon ||
+        *icon < 0 || *icon >= static_cast<int>(kIconCount)) {
+      continue;
+    }
+    containers.push_back({*id, base::UTF8ToUTF16(*name), *color, *icon});
+    if (containers.size() == kMaxContainers) {
+      break;
+    }
+  }
+  return containers;
+}
+
+std::optional<Container> FindContainer(Profile* profile,
+                                       const std::string& id) {
+  for (const auto& container : GetContainers(profile)) {
+    if (container.id == id) {
+      return container;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> SaveContainer(Profile* profile,
+                                         const std::string& id,
+                                         std::u16string name,
+                                         int color,
+                                         int icon) {
+  base::TrimWhitespace(name, base::TRIM_ALL, &name);
+  if (!profile || profile->IsOffTheRecord() || name.empty() ||
+      name.size() > 64 || color < 0 || color >= static_cast<int>(kColorCount) ||
+      icon < 0 || icon >= static_cast<int>(kIconCount) ||
+      (!id.empty() && !FindContainer(profile, id)) ||
+      (id.empty() && GetContainers(profile).size() >= kMaxContainers)) {
+    return std::nullopt;
+  }
+  const std::string result =
+      id.empty() ? base::Uuid::GenerateRandomV4().AsLowercaseString() : id;
+  ScopedListPrefUpdate update(profile->GetPrefs(), kContainersPref);
+  base::DictValue value = ToValue({result, std::move(name), color, icon});
+  for (auto& item : *update) {
+    if (item.is_dict() && item.GetDict().FindString("id") &&
+        *item.GetDict().FindString("id") == result) {
+      item = base::Value(std::move(value));
+      return result;
+    }
+  }
+  update->Append(std::move(value));
+  return result;
+}
+
+bool RemoveContainer(Profile* profile, const std::string& id) {
+  if (!FindContainer(profile, id)) {
+    return false;
+  }
+  auto* partition =
+      profile->GetStoragePartition(GetPartitionConfig(profile, id));
+  {
+    ScopedListPrefUpdate update(profile->GetPrefs(), kContainersPref);
+    update->EraseIf([&id](const base::Value& value) {
+      return value.is_dict() && value.GetDict().FindString("id") &&
+             *value.GetDict().FindString("id") == id;
+    });
+  }
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), nullptr, base::DoNothing());
+  partition->GetNetworkContext()->ClearHttpAuthCache(
+      base::Time(), base::Time::Max(), nullptr, base::DoNothing());
+  partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                       blink::StorageKey(), base::Time(), base::Time::Max(),
+                       base::DoNothing());
+  return true;
+}
+
+SkColor GetColor(int color) {
+  constexpr std::array<SkColor, kColorCount> colors = {
+      SkColorSetRGB(0x37, 0x78, 0xd4), SkColorSetRGB(0xe6, 0x89, 0x22),
+      SkColorSetRGB(0x2e, 0x96, 0x55), SkColorSetRGB(0xd6, 0x53, 0x87),
+      SkColorSetRGB(0x89, 0x64, 0xc8), SkColorSetRGB(0xda, 0x48, 0x48),
+      SkColorSetRGB(0x20, 0x98, 0xa0), SkColorSetRGB(0x7b, 0x80, 0x87)};
+  return colors[color >= 0 && color < static_cast<int>(colors.size()) ? color
+                                                                      : 0];
+}
+
+std::u16string GetIcon(int icon) {
+  constexpr std::array<const char16_t*, kIconCount> icons = {
+      u"●", u"▣", u"◆", u"◈", u"★", u"✿", u"▲", u"☂"};
+  return icons[icon >= 0 && icon < static_cast<int>(icons.size()) ? icon : 0];
+}
+
+std::string GetContainerId(content::WebContents* contents) {
+  if (!contents) {
+    return {};
+  }
+  const auto& config =
+      contents->GetPrimaryMainFrame()->GetStoragePartition()->GetConfig();
+  return config.partition_domain() == kPartitionDomain ? config.partition_name()
+                                                       : std::string();
+}
+
+content::StoragePartitionConfig GetPartitionConfig(Profile* profile,
+                                                   const std::string& id) {
+  CHECK(IsValidId(id));
+  return content::StoragePartitionConfig::Create(
+      profile, kPartitionDomain, id,
+      /*in_memory=*/profile->IsOffTheRecord() || !FindContainer(profile, id));
+}
+
+scoped_refptr<content::SiteInstance> CreateSiteInstance(Profile* profile,
+                                                        const GURL& url,
+                                                        const std::string& id) {
+  // A damaged session identifier must also fail closed.
+  const auto safe_id =
+      IsValidId(id) ? id : base::Uuid::GenerateRandomV4().AsLowercaseString();
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      profile, url, GetPartitionConfig(profile, safe_id));
+}
+
