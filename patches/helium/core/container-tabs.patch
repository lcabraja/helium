+std::unique_ptr<ui::SimpleMenuModel> CreateContainerMenu(
+    BrowserWindowInterface* browser,
+    std::vector<GURL> urls,
+    std::vector<base::WeakPtr<content::WebContents>> reopen) {
+  return std::make_unique<ContainerMenu>(browser, std::move(urls),
+                                         std::move(reopen));
+}
