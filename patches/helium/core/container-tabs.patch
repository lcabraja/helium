+std::vector<content::WebContents*> GetOpenTabs(Profile* profile,
+                                               const std::string& id) {
+  std::vector<content::WebContents*> result;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* b) {
+        if (b->GetProfile() == profile) {
+          auto* model = b->GetTabStripModel();
+          for (int i = 0; i < model->count(); ++i) {
+            auto* contents = model->GetWebContentsAt(i);
+            const auto tab_id = GetContainerId(contents);
+            if (!tab_id.empty() && (id.empty() || tab_id == id)) {
+              result.push_back(contents);
+            }
+          }
+        }
+        return true;
+      });
+  return result;
+}
+
+void CloseContainerTabs(Profile* profile, const std::string& id) {
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* b) {
+        if (b->GetProfile() == profile) {
+          auto* model = b->GetTabStripModel();
+          bool all_in_container = model->count() > 0;
+          for (int i = 0; i < model->count(); ++i) {
+            const auto tab_id = GetContainerId(model->GetWebContentsAt(i));
+            if (tab_id.empty() || (!id.empty() && tab_id != id)) {
+              all_in_container = false;
+            }
+          }
+          if (all_in_container) {
+            OpenInContainer(b, {}, {});
+          }
+          for (int i = model->count() - 1; i >= 0; --i) {
+            const auto tab_id = GetContainerId(model->GetWebContentsAt(i));
+            if (!tab_id.empty() && (id.empty() || tab_id == id)) {
+              model->CloseWebContentsAt(i, TabCloseTypes::CLOSE_USER_GESTURE);
+            }
+          }
+        }
+        return true;
+      });
+}
+
+views::Combobox* AddCombo(views::View* view,
+                          int label_id,
+                          std::vector<std::u16string> choices,
+                          size_t selected) {
+  view->AddChildView(std::make_unique<views::Label>(Text(label_id)));
+  std::vector<ui::SimpleComboboxModel::Item> items;
+  for (auto& choice : choices) {
+    items.emplace_back(std::move(choice));
+  }
+  auto* combo = view->AddChildView(std::make_unique<views::Combobox>(
+      std::make_unique<ui::SimpleComboboxModel>(std::move(items))));
+  combo->SetAccessibleName(Text(label_id));
+  combo->SetSelectedIndex(selected);
+  return combo;
+}
+
+void ShowEditor(BrowserWindowInterface* browser, std::string id) {
+  auto container = FindContainer(browser->GetProfile(), id);
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  auto* contents = dialog->SetContentsView(std::make_unique<views::View>());
+  dialog->SetTitle(Text(container ? IDS_CONTAINER_EDIT : IDS_CONTAINER_ADD));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_CONTAINER_SAVE));
+  contents->SetPreferredSize(gfx::Size(400, 330));
+  SetLayout(contents);
+  contents->AddChildView(
+      std::make_unique<views::Label>(Text(IDS_CONTAINER_NAME)));
+  auto* name = contents->AddChildView(std::make_unique<views::Textfield>());
+  name->SetAccessibleName(Text(IDS_CONTAINER_NAME));
+  if (container) {
+    name->SetText(container->name);
+  }
+  dialog->SetInitiallyFocusedView(name);
+  auto* color =
+      AddCombo(contents, IDS_CONTAINER_COLOR,
+               {Text(IDS_CONTAINER_BLUE), Text(IDS_CONTAINER_ORANGE),
+                Text(IDS_CONTAINER_GREEN), Text(IDS_CONTAINER_PINK),
+                Text(IDS_CONTAINER_PURPLE), Text(IDS_CONTAINER_RED),
+                Text(IDS_CONTAINER_TURQUOISE), Text(IDS_CONTAINER_GRAY)},
+               container ? container->color : 0);
+  auto* icon = AddCombo(contents, IDS_CONTAINER_ICON,
+                        {GetIcon(0), GetIcon(1), GetIcon(2), GetIcon(3),
+                         GetIcon(4), GetIcon(5), GetIcon(6), GetIcon(7)},
+                        container ? container->icon : 0);
+  auto* error = contents->AddChildView(std::make_unique<views::Label>());
+  error->SetMultiLine(true);
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<BrowserWindowInterface> browser, std::string id,
+         views::Textfield* name, views::Combobox* color, views::Combobox* icon,
+         views::Label* error) {
+        if (!browser) {
+          return true;
+        }
+        if (!SaveContainer(browser->GetProfile(), id,
+                           std::u16string(name->GetText()),
+                           color->GetSelectedIndex().value_or(0),
+                           icon->GetSelectedIndex().value_or(0))) {
+          error->SetText(Text(IDS_CONTAINER_INVALID_NAME));
+          name->RequestFocus();
+          return false;
+        }
+        return true;
+      },
+      browser->GetWeakPtr(), std::move(id), name, color, icon, error));
+  ShowDialog(browser, std::move(dialog));
+}
+
+void ConfirmRemoval(BrowserWindowInterface* browser, std::string id) {
+  const auto container = FindContainer(browser->GetProfile(), id);
+  if (!container) {
+    return;
+  }
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  auto* contents = dialog->SetContentsView(std::make_unique<views::View>());
+  dialog->SetTitle(Text(IDS_CONTAINER_DELETE));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_CONTAINER_DELETE));
+  SetLayout(contents);
+  auto* message = contents->AddChildView(
+      std::make_unique<views::Label>(l10n_util::GetStringFUTF16(
+          IDS_CONTAINER_DELETE_CONFIRM, container->name)));
+  message->SetMultiLine(true);
+  message->SetMaximumWidth(400);
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<BrowserWindowInterface> browser, std::string id,
+         views::Label* message) {
+        if (!browser) {
+          return true;
+        }
+        auto* profile = browser->GetProfile();
+        CloseContainerTabs(profile, id);
+        // Respect pages with beforeunload handlers. Never clear a live tab's
+        // partition, or it could recreate data after the deletion completes.
+        if (!GetOpenTabs(profile, id).empty()) {
+          message->SetText(Text(IDS_CONTAINER_CLOSE_PENDING));
+          return false;
+        }
+        RemoveContainer(profile, id);
+        return true;
+      },
+      browser->GetWeakPtr(), std::move(id), message));
+  ShowDialog(browser, std::move(dialog));
+}
