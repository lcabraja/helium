+class ContainerManager : public views::View {
+  METADATA_HEADER(ContainerManager, views::View)
+
+ public:
+  ContainerManager(BrowserWindowInterface* browser,
+                   views::DialogDelegate* dialog)
+      : browser_(browser->GetWeakPtr()) {
+    dialog->SetTitle(Text(IDS_CONTAINER_MANAGE));
+    dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+    dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                           Text(IDS_CONTAINER_DONE));
+    SetPreferredSize(gfx::Size(480, 520));
+    SetLayout(this);
+    auto* enabled = AddChildView(
+        std::make_unique<views::Checkbox>(Text(IDS_CONTAINER_ENABLED)));
+    enabled->SetChecked(IsEnabled(browser->GetProfile()));
+    enabled->SetCallback(base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser,
+           views::Checkbox* checkbox) {
+          if (browser) {
+            // Existing tabs keep their partitions when creation is disabled.
+            browser->GetProfile()->GetPrefs()->SetBoolean(
+                kEnabledPref, checkbox->GetChecked());
+          }
+        },
+        browser_, enabled));
+    auto* ask = AddChildView(
+        std::make_unique<views::Checkbox>(Text(IDS_CONTAINER_ASK_NEW_TAB)));
+    ask->SetChecked(
+        browser->GetProfile()->GetPrefs()->GetBoolean(kAskForNewTabPref));
+    ask->SetCallback(base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser,
+           views::Checkbox* checkbox) {
+          if (browser) {
+            browser->GetProfile()->GetPrefs()->SetBoolean(
+                kAskForNewTabPref, checkbox->GetChecked());
+          }
+        },
+        browser_, ask));
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->ClipHeightTo(0, 340);
+    rows_ = scroll->SetContents(std::make_unique<views::View>());
+    SetLayout(rows_);
+    AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(
+            [](base::WeakPtr<BrowserWindowInterface> browser) {
+              if (browser) {
+                ShowEditor(browser.get(), {});
+              }
+            },
+            browser_),
+        Text(IDS_CONTAINER_ADD)));
+    registrar_.Init(browser->GetProfile()->GetPrefs());
+    registrar_.Add(kContainersPref,
+                   base::BindRepeating(&ContainerManager::ScheduleRebuild,
+                                       weak_factory_.GetWeakPtr()));
+    Rebuild();
+  }
+
+ private:
+  void ScheduleRebuild() {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ContainerManager::Rebuild, weak_factory_.GetWeakPtr()));
+  }
+
+  void Rebuild() {
+    if (!browser_) {
+      return;
+    }
+    rows_->RemoveAllChildViews();
+    for (const auto& container : GetContainers(browser_->GetProfile())) {
+      auto* row = rows_->AddChildView(std::make_unique<views::View>());
+      auto* layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 12));
+      auto* name = row->AddChildView(std::make_unique<views::Label>(
+          GetIcon(container.icon) + u" " + container.name));
+      name->SetEnabledColor(GetColor(container.color));
+      name->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      layout->SetFlexForView(name, 1);
+      row->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(
+              [](base::WeakPtr<BrowserWindowInterface> browser,
+                 std::string id) {
+                if (browser) {
+                  ShowEditor(browser.get(), std::move(id));
+                }
+              },
+              browser_, container.id),
+          Text(IDS_CONTAINER_EDIT)));
+      row->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(
+              [](base::WeakPtr<BrowserWindowInterface> browser,
+                 std::string id) {
+                if (browser) {
+                  ConfirmRemoval(browser.get(), std::move(id));
+                }
+              },
+              browser_, container.id),
+          Text(IDS_CONTAINER_DELETE)));
+    }
+    PreferredSizeChanged();
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> rows_ = nullptr;
+  PrefChangeRegistrar registrar_;
+  base::WeakPtrFactory<ContainerManager> weak_factory_{this};
+};
