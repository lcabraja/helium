+#ifndef CHROME_BROWSER_CONTAINERS_CONTAINER_SERVICE_H_
+#define CHROME_BROWSER_CONTAINERS_CONTAINER_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class Profile;
+class GURL;
+class PrefRegistrySimple;
+namespace content {
+class SiteInstance;
+class WebContents;
+}  // namespace content
+
+namespace helium::containers {
+
+inline constexpr char kContainersPref[] = "helium.containers.identities";
+inline constexpr char kEnabledPref[] = "helium.containers.enabled";
+inline constexpr char kAskForNewTabPref[] = "helium.containers.ask_for_new_tab";
+inline constexpr char kSessionKey[] = "helium.container_id";
+inline constexpr char kPartitionDomain[] = "helium-containers";
+inline constexpr size_t kMaxContainers = 100;
+inline constexpr size_t kColorCount = 8;
+inline constexpr size_t kIconCount = 8;
+
+struct Container {
+  std::string id;
+  std::u16string name;
+  int color = 0;
+  int icon = 0;
+};
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+bool IsEnabled(Profile* profile);
+std::vector<Container> GetContainers(Profile* profile);
+std::optional<Container> FindContainer(Profile* profile, const std::string& id);
+// IDs never change on rename and are never reused after deletion.
+std::optional<std::string> SaveContainer(Profile* profile,
+                                         const std::string& id,
+                                         std::u16string name,
+                                         int color,
+                                         int icon);
+// Call only after closing the container's tabs. Erases all partition data.
+bool RemoveContainer(Profile* profile, const std::string& id);
+SkColor GetColor(int color);
+std::u16string GetIcon(int icon);
+
+// Read identity from the actual storage partition, including popups and clones.
+std::string GetContainerId(content::WebContents* contents);
+content::StoragePartitionConfig GetPartitionConfig(Profile* profile,
+                                                   const std::string& id);
+// Unknown/deleted identities restore into an empty, memory-only partition.
+// They must never fall back to the profile's authenticated default partition.
+scoped_refptr<content::SiteInstance> CreateSiteInstance(Profile* profile,
+                                                        const GURL& url,
+                                                        const std::string& id);
+
+}  // namespace helium::containers
+
+#endif  // CHROME_BROWSER_CONTAINERS_CONTAINER_SERVICE_H_
