+bool OpenInContainer(BrowserWindowInterface* browser,
+                     const std::vector<GURL>& urls,
+                     const std::string& id) {
+  if (!browser || browser->GetProfile()->IsOffTheRecord() ||
+      (!id.empty() && (!IsEnabled(browser->GetProfile()) ||
+                       !FindContainer(browser->GetProfile(), id)))) {
+    return false;
+  }
+  const std::vector<GURL> targets =
+      urls.empty() ? std::vector<GURL>{GURL(chrome::kChromeUINewTabURL)} : urls;
+  bool first = true;
+  bool opened = false;
+  for (const auto& url : targets) {
+    // Never execute a bookmarklet in another container or carry an origin-bound
+    // blob/filesystem URL into a different identity.
+    if (!url.is_valid() || url.SchemeIs("javascript") || url.SchemeIs("blob") ||
+        url.SchemeIsFileSystem()) {
+      continue;
+    }
+    NavigateParams params(browser, url, ui::PAGE_TRANSITION_LINK);
+    params.container_id = id;
+    params.disposition = first ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                               : WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params.window_action = NavigateParams::WindowAction::kShowWindow;
+    Navigate(&params);
+    opened |= params.navigated_or_inserted_contents != nullptr;
+    first = false;
+  }
+  return opened;
+}
+
+void ShowContainerPicker(BrowserWindowInterface* browser,
+                         std::vector<GURL> urls) {
+  if (!browser || !IsEnabled(browser->GetProfile())) {
+    return;
+  }
+  const auto containers = GetContainers(browser->GetProfile());
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  auto* contents = dialog->SetContentsView(std::make_unique<views::View>());
+  dialog->SetTitle(Text(IDS_CONTAINER_NEW_TAB));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_CONTAINER_OPEN));
+  contents->SetPreferredSize(gfx::Size(400, 160));
+  SetLayout(contents);
+  std::vector<std::u16string> choices = {Text(IDS_CONTAINER_NONE)};
+  for (const auto& container : containers) {
+    choices.push_back(GetIcon(container.icon) + u" " + container.name);
+  }
+  auto* combo = AddCombo(contents, IDS_CONTAINER_CHOOSE, std::move(choices),
+                         containers.empty() ? 0 : 1);
+  dialog->SetInitiallyFocusedView(combo);
+  dialog->SetAcceptCallback(base::BindOnce(
+      [](base::WeakPtr<BrowserWindowInterface> browser, std::vector<GURL> urls,
+         std::vector<Container> containers, views::Combobox* combo) {
+        if (browser) {
+          const size_t index = combo->GetSelectedIndex().value_or(0);
+          OpenInContainer(
+              browser.get(), urls,
+              index == 0 ? std::string() : containers[index - 1].id);
+        }
+      },
+      browser->GetWeakPtr(), std::move(urls), containers, combo));
+  dialog->SetExtraView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserWindowInterface> browser) {
+            if (browser) {
+              ShowContainerManager(browser.get());
+            }
+          },
+          browser->GetWeakPtr()),
+      Text(IDS_CONTAINER_MANAGE)));
+  ShowDialog(browser, std::move(dialog));
+}
+
+void RegisterContainerWebUI(content::WebUI* web_ui,
+                            content::WebUIDataSource* source) {
+  source->AddLocalizedString("openInContainer", IDS_CONTAINER_OPEN_TABS);
+  source->AddLocalizedString("containerManage", IDS_CONTAINER_MANAGE);
+  source->AddBoolean("containersAvailable",
+                     IsEnabled(Profile::FromWebUI(web_ui)));
+  web_ui->AddMessageHandler(std::make_unique<ContainerWebUIHandler>());
+}
+
+void ShowContainerManager(BrowserWindowInterface* browser) {
+  if (browser && !browser->GetProfile()->IsOffTheRecord()) {
+    auto dialog = std::make_unique<views::DialogDelegate>();
+    dialog->SetContentsView(
+        std::make_unique<ContainerManager>(browser, dialog.get()));
+    ShowDialog(browser, std::move(dialog));
+  }
+}
