 TabStyleViews::TabStyleViews() : tab_style_(TabStyle::Get()) {}
 
 TabStyleViews::~TabStyleViews() = default;
+
+void TabStyleViews::PaintContainerCrest(gfx::Canvas* canvas, SkColor color) const {
+  const SkPath outline = GetPath(
+      TabStyle::PathType::kHighlight, canvas->image_scale(),
+      {.render_units = TabStyle::RenderUnits::kDips,
+       .should_paint_extension = false});
+  const SkRect bounds = outline.getBounds();
+  if (bounds.isEmpty()) {
+    return;
+  }
+
+  // Follow the actual rounded tab, including pinned and vertical tabs. Clip a
+  // four-DIP stroke to its interior so the visible line is two DIPs wide.
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipPath(outline, true);
+
+  // Fade the two side endpoints over the last five DIPs above the midpoint.
+  // Clamping to transparent below it also hides the entire lower outline.
+  const float midpoint = bounds.centerY();
+  const SkPoint points[] = {
+      SkPoint::Make(0, std::max(bounds.top(), midpoint - 5.0f)),
+      SkPoint::Make(0, midpoint),
+  };
+  const SkColor4f colors[] = {
+      SkColor4f::FromColor(color),
+      SkColor4f::FromColor(SkColorSetA(color, SK_AlphaTRANSPARENT)),
+  };
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(4.0f);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, /*pos=*/nullptr, 2, SkTileMode::kClamp));
+  canvas->DrawPath(outline, flags);
+}
