+IN_PROC_BROWSER_TEST_F(ContainerBrowserTest, BlankPageKeepsPartition) {
+  auto* work = Open(Work());
+  ASSERT_TRUE(content::ExecJs(work, "document.cookie = 'account=work; path=/'"));
+  auto* partition = work->GetPrimaryMainFrame()->GetStoragePartition();
+  content::WebContents::CreateParams params(browser()->GetProfile());
+  params.site_instance = CreateSiteInstance(browser()->GetProfile(),
+                                            GURL("about:blank"), Work());
+  auto tab = content::WebContents::Create(params);
+  EXPECT_EQ(partition, tab->GetPrimaryMainFrame()->GetStoragePartition());
+  ASSERT_TRUE(content::NavigateToURL(
+      tab.get(), embedded_test_server()->GetURL("/test")));
+  EXPECT_EQ(partition, tab->GetPrimaryMainFrame()->GetStoragePartition());
+  EXPECT_EQ("account=work", content::EvalJs(tab.get(), "document.cookie"));
